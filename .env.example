# Copiez ce fichier en .env puis remplacez par l'URL réelle de votre backend
# (avant de builder l'APK pour les testeurs)
#
# Exemple si le backend est en ligne : https://api.babylone.com
# Exemple en local / tunnel ngrok : https://xxxx.ngrok.io

VITE_API_URL=https://VOTRE-URL-BACKEND/api/v1
VITE_SOCKET_URL=https://VOTRE-URL-BACKEND
