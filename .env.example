# Copiez ce fichier en .env puis remplacez par l'URL réelle de votre backend
# (avant de builder le site ou l'APK pour les testeurs)
#
# Exemple avec Railway :
# VITE_API_URL=https://babylone-production.up.railway.app/api/v1
# VITE_SOCKET_URL=https://babylone-production.up.railway.app

VITE_API_URL=https://VOTRE-URL-BACKEND/api/v1
VITE_SOCKET_URL=https://VOTRE-URL-BACKEND
